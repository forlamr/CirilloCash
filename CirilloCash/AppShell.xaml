<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CirilloCash.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CirilloCash"
    Shell.FlyoutBehavior="Flyout"
    Title="CirilloCash" 
    TitleColor="White">

    <FlyoutItem Title="Home" Icon="home.png">
        <ShellContent Title="CirilloCash App"
                  ContentTemplate="{DataTemplate local:MainPage}"
                  Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Transazioni" Icon="settings.png">
        <ShellContent Title="Transazioni"
                  ContentTemplate="{DataTemplate local:TransactionsPage}"
                  Route="TransactionsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Resoconto">
        <ShellContent Title="Resoconto"
                  ContentTemplate="{DataTemplate local:ResultsPage}"
                  Route="ResultsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Stampante">
        <ShellContent Title="Impostazioni Stampante"
                  ContentTemplate="{DataTemplate local:PrinterSettingsPage}"
                  Route="PrinterSettingsPage" />
    </FlyoutItem>

</Shell>
