<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CirilloCash.PrinterSettingsPage"
             Title="Impostazioni Stampante">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Configurazione stampante termica." FontAttributes="Bold" />

            <Label Text="Tipo stampante" />
            <Picker x:Name="PrinterTypePicker" SelectedIndexChanged="OnPrinterTypeChanged">
                <Picker.Items>
                    <x:String>X5 (Bluetooth)</x:String>
                    <x:String>Ethernet (TCP/ESC-POS)</x:String>
                </Picker.Items>
            </Picker>

            <VerticalStackLayout x:Name="X5Section" Spacing="8">
                <Label Text="Nome stampante (parziale)" />
                <Entry x:Name="PrinterNameEntry" Placeholder="X5" />

                <Label Text="MAC stampante (opzionale, consigliato)" />
                <Entry x:Name="PrinterMacEntry" Placeholder="AA:BB:CC:DD:EE:FF" TextTransform="Uppercase" />

                <Label Text="Protocollo: JL_SPP_RASTER" FontSize="12" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="EthSection" Spacing="8" IsVisible="False">
                <Label Text="Host / IP stampante" />
                <Entry x:Name="HostEntry" Placeholder="192.168.1.100" Keyboard="Url" />

                <Label Text="Porta TCP" />
                <Entry x:Name="PortEntry" Placeholder="9100" Keyboard="Numeric" />

                <Label Text="Protocollo: ESC/POS su TCP" FontSize="12" />
            </VerticalStackLayout>

            <Button Text="Salva" Clicked="OnSaveClicked" />
            <Button Text="Stampa di prova" Clicked="OnTestPrintClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
