<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CirilloCash.MainPage">
    <ContentPage.Resources>
        <Color x:Key="PageCream">#ECECEC</Color>
        <Color x:Key="PageSand">#DDDDDD</Color>
        <Color x:Key="CardIvory">#F8F8F8</Color>
        <Color x:Key="CardPeach">#ECECEC</Color>
        <Color x:Key="LineWarm">#BEBEBE</Color>
        <Color x:Key="InkWarm">#1F1F1F</Color>
        <Color x:Key="MutedWarm">#6B6B6B</Color>
        <Color x:Key="AccentTerracotta">#3D3D3D</Color>
        <Color x:Key="AccentTeal">#194C63</Color>
        <Color x:Key="AccentGold">#F0CC3C</Color>
        <Color x:Key="AccentBerry">#BDBDBD</Color>
        <Color x:Key="AccentSoft">#D3D3D3</Color>
        <Color x:Key="AccentMint">#BFE6FF</Color>
        <Color x:Key="AccentButter">#F6DD69</Color>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource LineWarm}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource CardIvory}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource InkWarm}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource MutedWarm}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DrinkButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
            <Setter Property="TextColor" Value="{StaticResource InkWarm}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#BBBBBB" />
                                <Setter Property="Scale" Value="0.98" />
                                <Setter Property="Opacity" Value="0.92" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="RemoveDrinkButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentBerry}" />
            <Setter Property="TextColor" Value="{StaticResource InkWarm}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="WidthRequest" Value="62" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#A8A8A8" />
                                <Setter Property="Scale" Value="0.97" />
                                <Setter Property="Opacity" Value="0.9" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="MoneyButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentMint}" />
            <Setter Property="TextColor" Value="{StaticResource AccentTeal}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#9FD2F2" />
                                <Setter Property="Scale" Value="0.98" />
                                <Setter Property="Opacity" Value="0.92" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ActionPrimaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentGold}" />
            <Setter Property="TextColor" Value="{StaticResource InkWarm}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D9B92F" />
                                <Setter Property="Scale" Value="0.98" />
                                <Setter Property="Opacity" Value="0.92" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
            <Setter Property="TextColor" Value="{StaticResource InkWarm}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#BBBBBB" />
                                <Setter Property="Scale" Value="0.98" />
                                <Setter Property="Opacity" Value="0.92" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ReceiptLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource InkWarm}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>

        <Style x:Key="ReceiptValueLabelStyle" TargetType="Label" BasedOn="{StaticResource ReceiptLabelStyle}">
            <Setter Property="HorizontalTextAlignment" Value="End" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource AccentTeal}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource PageCream}" Offset="0.0" />
            <GradientStop Color="{StaticResource PageSand}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,22" Spacing="12">
            <VerticalStackLayout Spacing="2" Padding="2,0,2,4">
                <Label Text="Cirillo Cash" TextColor="{StaticResource InkWarm}" FontFamily="OpenSansSemibold" FontSize="28" />
                <Label Text="Cassa" TextColor="{StaticResource MutedWarm}" FontFamily="OpenSansRegular" FontSize="14" />
                <BoxView HeightRequest="2" WidthRequest="72" HorizontalOptions="Start" BackgroundColor="{StaticResource AccentGold}" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <Border Style="{StaticResource SectionBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Ordine" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Aggiungi o rimuovi articoli." Style="{StaticResource SectionCaptionStyle}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="DrinksTabBtn" Grid.Column="0" Text="DRINK" Clicked="OnDrinksTabClicked" Style="{StaticResource NeutralButtonStyle}" />
                        <Button x:Name="FoodTabBtn"   Grid.Column="1" Text="FOOD"  Clicked="OnFoodTabClicked"   Style="{StaticResource NeutralButtonStyle}" />
                    </Grid>

                    <CollectionView x:Name="OrderItemsView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4" ColumnDefinitions="*,Auto,62" ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="{Binding ButtonLabel}"
                                            Clicked="OnAddItemClicked"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource DrinkButtonStyle}" />
                                    <Label  Grid.Column="1"
                                            Text="{Binding QuantityText}"
                                            Style="{StaticResource ReceiptValueLabelStyle}"
                                            VerticalOptions="Center"
                                            WidthRequest="48"
                                            HorizontalTextAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Text="-"
                                            Clicked="OnRemoveItemClicked"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource RemoveDrinkButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Nessun articolo in questa categoria. Aggiungilo dal menu 'Catalogo'."
                                   HorizontalTextAlignment="Center" Padding="20" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Conto" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Riepilogo e totale." Style="{StaticResource SectionCaptionStyle}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#F1F1F1" Stroke="{StaticResource LineWarm}" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="EmptyBillLb" Text="Nessun articolo selezionato."
                                   HorizontalTextAlignment="Center" Padding="6" />

                            <VerticalStackLayout x:Name="DrinkBillSection" Spacing="4" IsVisible="False">
                                <Label Text="DRINK" FontAttributes="Bold" Style="{StaticResource ReceiptLabelStyle}" />
                                <CollectionView x:Name="DrinkBillView" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" ColumnDefinitions="*,Auto,Auto">
                                                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ReceiptLabelStyle}" />
                                                <Label Grid.Column="1" Text="{Binding QuantityXPrice}" Style="{StaticResource ReceiptValueLabelStyle}" />
                                                <Label Grid.Column="2" Text="{Binding LineTotalText}" Style="{StaticResource ReceiptValueLabelStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="FoodBillSection" Spacing="4" IsVisible="False">
                                <Label Text="FOOD" FontAttributes="Bold" Style="{StaticResource ReceiptLabelStyle}" />
                                <CollectionView x:Name="FoodBillView" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" ColumnDefinitions="*,Auto,Auto">
                                                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ReceiptLabelStyle}" />
                                                <Label Grid.Column="1" Text="{Binding QuantityXPrice}" Style="{StaticResource ReceiptValueLabelStyle}" />
                                                <Label Grid.Column="2" Text="{Binding LineTotalText}" Style="{StaticResource ReceiptValueLabelStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource LineWarm}" />

                            <Grid ColumnSpacing="10" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="TOTALE" Style="{StaticResource ReceiptLabelStyle}" FontAttributes="Bold" />
                                <Label Grid.Column="1" x:Name="TotaleLb" Text="0,00 €" Style="{StaticResource ReceiptValueLabelStyle}" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <VerticalStackLayout x:Name="RestoGrid" Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Pagamento e Resto" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Contanti e resto." Style="{StaticResource SectionCaptionStyle}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border BackgroundColor="#F1F1F1" Padding="10" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0" />
                            </Border.StrokeShape>
                            <Label x:Name="MoneyLb" Text="" Style="{StaticResource SummaryLabelStyle}" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#F1F1F1" Padding="10" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0" />
                            </Border.StrokeShape>
                            <Label x:Name="ReminderLb" Text="" Style="{StaticResource SummaryLabelStyle}" TextColor="{StaticResource AccentTeal}" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button x:Name="M100" Text="100 €" Grid.Row="0" Grid.Column="0" Clicked="OnM100Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M50" Text="50 €" Grid.Row="0" Grid.Column="1" Clicked="OnM50Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M20" Text="20 €" Grid.Row="0" Grid.Column="2" Clicked="OnM20Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M10" Text="10 €" Grid.Row="0" Grid.Column="3" Clicked="OnM10Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M5" Text="5 €" Grid.Row="1" Grid.Column="0" Clicked="OnM5Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M2" Text="2 €" Grid.Row="1" Grid.Column="1" Clicked="OnM2Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M1" Text="1 €" Grid.Row="1" Grid.Column="2" Clicked="OnM1Clicked" Style="{StaticResource MoneyButtonStyle}" />
                        <Button x:Name="M05" Text="0,50 €" Grid.Row="1" Grid.Column="3" Clicked="OnM05Clicked" Style="{StaticResource MoneyButtonStyle}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="CleanMoneyBtn" Text="Azzera" Grid.Column="0" Clicked="OnCleanMoneyClicked" Style="{StaticResource NeutralButtonStyle}" />
                        <Button x:Name="ComputeRemainderBtn" Text="Calcola resto" Grid.Column="1" Clicked="OnComputeReminderClicked" Style="{StaticResource NeutralButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <VerticalStackLayout x:Name="UtilityGrid" Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Azioni" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Gestione operazioni." Style="{StaticResource SectionCaptionStyle}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button x:Name="CleanBtn" Text="Pulisci" Grid.Column="0" Clicked="OnCleanClicked" Style="{StaticResource ActionPrimaryButtonStyle}" />
                        <Button x:Name="SaveBtn" Text="Salva" Grid.Column="1" Clicked="OnSaveClicked" Style="{StaticResource ActionPrimaryButtonStyle}" />
                        <Button x:Name="PrintBtn" Text="Stampa" Grid.Column="2" Clicked="OnPrintClicked" Style="{StaticResource ActionPrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
