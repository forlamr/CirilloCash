<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CirilloCash.MainPage">


    <Grid Padding="5" RowSpacing="0" ColumnSpacing="0" BackgroundColor="Black">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Grid Bevande e Conto -->
        <Grid Grid.Row="0" Padding="5" RowSpacing="5" ColumnSpacing="5" BackgroundColor="Black">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Grid Bevande -->
            <Grid Grid.Column="0" Padding="10" RowSpacing="10" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AddBlondeBeerBtn" Text="Bionda" Grid.Row="0" Grid.Column="0" Clicked="OnAddBlondeBeerClicked"/>
                <Button x:Name="RemoveBlondeBeerBtn" Text="-" Grid.Row="0" Grid.Column="1" Clicked="OnRemoveBlondeBeerClicked"/>
                <Button x:Name="AddRedBeerBtn" Text="Rossa" Grid.Row="1" Grid.Column="0" Clicked="OnAddRedBeerClicked"/>
                <Button x:Name="RemoveRedBeerBtn" Text="-" Grid.Row="1" Grid.Column="1" Clicked="OnRemoveRedBeerClicked"/>
                <Button x:Name="AddSpritzBtn" Text="Spritz" Grid.Row="2" Grid.Column="0" Clicked="OnAddSpritzClicked"/>
                <Button x:Name="RemoveSpritzBtn" Text="-" Grid.Row="2" Grid.Column="1" Clicked="OnRemoveSpritzClicked"/>
                <Button x:Name="AddWaterBtn" Text="Acqua" Grid.Row="3" Grid.Column="0" Clicked="OnAddWaterClicked"/>
                <Button x:Name="RemoveWaterBtn" Text="-" Grid.Row="3" Grid.Column="1" Clicked="OnRemoveWaterClicked"/>
                <Button x:Name="AddCocaColaBtn" Text="Coca-Cola" Grid.Row="4" Grid.Column="0" Clicked="OnAddCocaColaClicked"/>
                <Button x:Name="RemoveCocaColaBtn" Text="-" Grid.Row="4" Grid.Column="1" Clicked="OnRemoveCocaColaClicked"/>
            </Grid>

            <!-- Grid Conto -->
            <Grid x:Name="TotaleGrid" Grid.Column="1" Padding="10" RowSpacing="10" ColumnSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="Label00" Text="" Grid.Row="0" Grid.Column="0"/>
                <Label x:Name="Label01" Text="" Grid.Row="0" Grid.Column="1"/>
                <Label x:Name="Label02" Text="" Grid.Row="0" Grid.Column="2"/>
                <Label x:Name="Label10" Text="" Grid.Row="1" Grid.Column="0"/>
                <Label x:Name="Label11" Text="" Grid.Row="1" Grid.Column="1"/>
                <Label x:Name="Label12" Text="" Grid.Row="1" Grid.Column="2"/>
                <Label x:Name="Label20" Text="" Grid.Row="2" Grid.Column="0"/>
                <Label x:Name="Label21" Text="" Grid.Row="2" Grid.Column="1"/>
                <Label x:Name="Label22" Text="" Grid.Row="2" Grid.Column="2"/>
                <Label x:Name="Label30" Text="" Grid.Row="3" Grid.Column="0"/>
                <Label x:Name="Label31" Text="" Grid.Row="3" Grid.Column="1"/>
                <Label x:Name="Label32" Text="" Grid.Row="3" Grid.Column="2"/>
                <Label x:Name="Label40" Text="" Grid.Row="4" Grid.Column="0"/>
                <Label x:Name="Label41" Text="" Grid.Row="4" Grid.Column="1"/>
                <Label x:Name="Label42" Text="" Grid.Row="4" Grid.Column="2"/>
                <Label x:Name="Label50" Text="" Grid.Row="5" Grid.Column="0"/>
                <Label x:Name="Label51" Text="" Grid.Row="5" Grid.Column="1"/>
                <Label x:Name="Label52" Text="" Grid.Row="5" Grid.Column="2"/>
                <Label x:Name="Label60" Text="" Grid.Row="6" Grid.Column="0"/>
                <Label x:Name="Label61" Text="" Grid.Row="6" Grid.Column="1"/>
                <Label x:Name="Label62" Text="" Grid.Row="6" Grid.Column="2"/>
                <Label x:Name="Label70" Text="" Grid.Row="7" Grid.Column="0"/>
                <Label x:Name="Label71" Text="" Grid.Row="7" Grid.Column="1"/>
                <Label x:Name="Label72" Text="" Grid.Row="7" Grid.Column="2"/>
                <Label x:Name="Label80" Text="" Grid.Row="8" Grid.Column="0"/>
                <Label x:Name="Label81" Text="" Grid.Row="8" Grid.Column="1"/>
                <Label x:Name="Label82" Text="" Grid.Row="8" Grid.Column="2"/>
            </Grid>
        </Grid>



        <!-- Grid Resto -->
        <Grid x:Name="RestoGrid" Grid.Row="1" Padding="10" RowSpacing="10" ColumnSpacing="20" BackgroundColor="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="M100" Text="100 €" Grid.Row="0" Grid.Column="0" Clicked="OnM100Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M50" Text="50 €" Grid.Row="1" Grid.Column="0" Clicked="OnM50Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M20" Text="20 €" Grid.Row="2" Grid.Column="0" Clicked="OnM20Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M10" Text="10 €" Grid.Row="4" Grid.Column="0" Clicked="OnM10Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M5" Text="5 €" Grid.Row="0" Grid.Column="1" Clicked="OnM5Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M2" Text="2 €" Grid.Row="1" Grid.Column="1" Clicked="OnM2Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M1" Text="1 €" Grid.Row="2" Grid.Column="1" Clicked="OnM1Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="M05" Text="0.50 €" Grid.Row="3" Grid.Column="1" Clicked="OnM05Clicked" BackgroundColor="LightSeaGreen"/>
            <Button x:Name="CleanMoneyBtn" Text="Azzera" Grid.Row="0" Grid.Column="2" Clicked="OnCleanMoneyClicked"/>
            <Button x:Name="ComputeRemainderBtn" Text="Calcola Resto" Grid.Row="1" Grid.Column="3" Clicked="OnComputeReminderClicked"/>
            <Label x:Name="MoneyLb" Text="" Grid.Row="2" Grid.Column="3"/>
            <Label x:Name="ReminderLb" Text="" Grid.Row="3" Grid.Column="3"/>
        </Grid>

        <!-- Grid Utility -->
        <Grid x:Name="UtilityGrid" Grid.Row="2" Padding="10" RowSpacing="10" ColumnSpacing="20" BackgroundColor="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CleanBtn" Text="Clean" Grid.Row="0" Grid.Column="0" Clicked="OnCleanClicked" BackgroundColor="Yellow"/>
            <Button x:Name="SaveBtn" Text="Save" Grid.Row="0" Grid.Column="1" Clicked="OnSaveClicked" BackgroundColor="Yellow"/>
        </Grid>
    </Grid>

</ContentPage>